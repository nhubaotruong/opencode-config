{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "verbosity": "medium",
    "permissions": "autoaccept"
  },
  "animations": true,
  "theme": {
    "mode": "system",
    "name": "aura"
  },
  "attention": {
    "notifications": true
  },
  "debug": {
    "devtools": false
  },
  "terminal": {
    "title": true
  }
}
